@@ -2113,6 +2132,68 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 // output
 //
 
+// One sequence, consecutive positions, token ids only: the engine owns every other
+// detail of the forward, and returns the logits rows the batch asked for.
+int llama_context::decode_remote(const llama_batch_ext & batch_inp) {
+    const size_t n = batch_inp.tokens.size();
+    if (n == 0) {
+        LLAMA_LOG_ERROR("%s: n_tokens == 0\n", __func__);
+        return -1;
+    }
+    const int32_t pos0 = batch_inp.tokens[0].pos[0];
+    std::vector<int32_t> ids(n);
+    std::vector<uint8_t> want(n);
+    int32_t n_out = 0;
+    for (size_t i = 0; i < n; ++i) {
+        const auto & tok = batch_inp.tokens[i];
+        if (tok.has_embd || tok.pos[0] != pos0 + (int32_t) i) {
+            LLAMA_LOG_ERROR("%s: the remote backend takes consecutive token ids only\n", __func__);
+            return -1;
+        }
+        for (auto s : tok.seq_ids) {
+            if (s != 0) {
+                LLAMA_LOG_ERROR("%s: the remote backend serves sequence 0 only\n", __func__);
+                return -1;
+            }
+        }
+        ids[i]  = tok.id;
+        want[i] = (cparams.embeddings || tok.output) ? 1 : 0;
+        n_out  += want[i];
+    }
+    if (t_compute_start_us == 0) {
+        t_compute_start_us = ggml_time_us();
+    }
+    if (output_reserve(n_out) < (uint32_t) n_out) {
+        LLAMA_LOG_ERROR("%s: could not reserve space for %d outputs\n", __func__, n_out);
+        return -2;
+    }
+    output_swaps.clear();
+    try {
+        if (remote->decode(ids, pos0, want, logits.data) != 0) {
+            return -3;
+        }
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -3;
+    }
+    n_outputs = n_out;
+    std::fill(output_ids.begin(), output_ids.end(), -1);
+    for (size_t i = 0, k = 0; i < n; ++i) {
+        if (want[i]) {
+            output_ids[i] = (int32_t) k++;
+        }
+    }
+    if (n == 1) {
+        n_eval++;
+        t_eval_us += ggml_time_us() - t_compute_start_us;
+    } else {
+        n_p_eval += n;
+        t_p_eval_us += ggml_time_us() - t_compute_start_us;
+    }
+    t_compute_start_us = 0;
+    return 0;
+}
+
 uint32_t llama_context::output_reserve(int32_t n_outputs) {
     const auto & hparams = model.hparams;
     const auto & vocab   = model.vocab;
