diff --git a/src/llama-remote.cpp b/src/llama-remote.cpp
new file mode 100644
index 0000000..9976f2e
--- /dev/null
+++ b/src/llama-remote.cpp
@@ -0,0 +1,141 @@
+#include "llama-remote.h"
+
+#include "llama-impl.h"
+
+#include <cerrno>
+#include <cstring>
+#include <stdexcept>
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+llama_remote_client::llama_remote_client(const std::string & path) {
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        throw std::runtime_error("remote backend: socket() failed");
+    }
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(addr.sun_path)) {
+        throw std::runtime_error("remote backend: socket path too long");
+    }
+    std::memcpy(addr.sun_path, path.c_str(), path.size() + 1);
+    if (connect(fd, (const sockaddr *) &addr, sizeof(addr)) != 0) {
+        const int e = errno;
+        close(fd);
+        fd = -1;
+        throw std::runtime_error("remote backend: cannot connect to " + path + ": " + std::strerror(e));
+    }
+    request(LLAMA_REMOTE_INFO, 0, 0, 0);
+    int32_t info[4];
+    recv_all(info, sizeof(info));
+    n_vocab  = info[0];
+    n_ctx    = info[1];
+    n_embd   = info[2];
+    n_cached = info[3];
+    LLAMA_LOG_INFO("%s: connected to %s: n_vocab = %d, n_ctx = %d, n_embd = %d, n_cached = %d\n",
+            __func__, path.c_str(), n_vocab, n_ctx, n_embd, n_cached);
+}
+
+llama_remote_client::~llama_remote_client() {
+    if (fd >= 0) {
+        close(fd);
+    }
+}
+
+void llama_remote_client::send_all(const void * p, size_t n) {
+    const char * c = (const char *) p;
+    while (n > 0) {
+        const ssize_t k = write(fd, c, n);
+        if (k <= 0) {
+            if (k < 0 && errno == EINTR) {
+                continue;
+            }
+            throw std::runtime_error("remote backend: connection lost (write)");
+        }
+        c += k;
+        n -= (size_t) k;
+    }
+}
+
+void llama_remote_client::recv_all(void * p, size_t n) {
+    char * c = (char *) p;
+    while (n > 0) {
+        const ssize_t k = read(fd, c, n);
+        if (k <= 0) {
+            if (k < 0 && errno == EINTR) {
+                continue;
+            }
+            throw std::runtime_error("remote backend: connection lost (read)");
+        }
+        c += k;
+        n -= (size_t) k;
+    }
+}
+
+void llama_remote_client::request(uint32_t op, uint32_t n, int32_t pos0, uint32_t n_out) {
+    const uint32_t hdr[4] = { op, n, (uint32_t) pos0, n_out };
+    send_all(hdr, sizeof(hdr));
+}
+
+int llama_remote_client::decode(const std::vector<int32_t> & tokens, int32_t pos0,
+                                const std::vector<uint8_t> & want, float * logits) {
+    uint32_t n_out = 0;
+    for (uint8_t w : want) {
+        n_out += w != 0;
+    }
+    request(LLAMA_REMOTE_DECODE, (uint32_t) tokens.size(), pos0, n_out);
+    send_all(tokens.data(), tokens.size() * sizeof(int32_t));
+    send_all(want.data(), want.size());
+    int32_t status = 0;
+    recv_all(&status, sizeof(status));
+    if (status != 0) {
+        LLAMA_LOG_ERROR("%s: engine refused a batch of %zu tokens at position %d (status %d, engine holds %d)\n",
+                __func__, tokens.size(), pos0, status, n_cached);
+        return status;
+    }
+    recv_all(logits, (size_t) n_out * n_vocab * sizeof(float));
+    n_cached = pos0 + (int32_t) tokens.size();
+    return 0;
+}
+
+bool llama_remote_client::truncate(int32_t pos) {
+    request(LLAMA_REMOTE_TRUNCATE, 0, pos, 0);
+    int32_t r[2];
+    recv_all(r, sizeof(r));
+    n_cached = r[1];
+    return r[0] == 0;
+}
+
+void llama_remote_client::reset() {
+    request(LLAMA_REMOTE_RESET, 0, 0, 0);
+    int32_t status;
+    recv_all(&status, sizeof(status));
+    n_cached = 0;
+}
+
+void llama_memory_remote::clear(bool /*data*/) {
+    cl.reset();
+}
+
+bool llama_memory_remote::seq_rm(llama_seq_id /*seq_id*/, llama_pos p0, llama_pos p1) {
+    if (p0 < 0) {
+        p0 = 0;
+    }
+    if (p1 >= 0 && p1 < cl.n_cached) {
+        return false;   // removing a range in the middle needs positional memory
+    }
+    if (p0 >= cl.n_cached) {
+        return true;
+    }
+    return cl.truncate(p0);
+}
+
+void llama_memory_remote::state_write(llama_io_write_i &, llama_seq_id, llama_state_seq_flags) const {
+    throw std::runtime_error("remote backend: state save is not supported (run llama-server with --cache-ram 0 --ctx-checkpoints 0)");
+}
+
+void llama_memory_remote::state_read(llama_io_read_i &, llama_seq_id, llama_state_seq_flags) {
+    throw std::runtime_error("remote backend: state load is not supported");
+}
diff --git a/src/llama-remote.h b/src/llama-remote.h
new file mode 100644
index 0000000..ea4ff00
--- /dev/null
+++ b/src/llama-remote.h
@@ -0,0 +1,79 @@
+#pragma once
+
+// Remote compute backend: llama.cpp keeps tokenization, chat templates, sampling and the
+// server, and sends every decode to an engine process over a UNIX socket
+// (LLAMA_REMOTE_BACKEND=/path/to/socket). The model is then loaded vocab-only.
+// Protocol (little endian), shared with the kimi-k3-in-c engine (k3 --serve):
+//   request:  u32 op, u32 n, i32 pos0, u32 n_out, then the op's payload
+//   INFO      -> i32 vocab, i32 n_ctx, i32 n_embd, i32 n_cached
+//   DECODE    payload i32 tokens[n], u8 want[n] -> i32 status, then n_out*vocab floats
+//   TRUNCATE  pos0 = first position to drop -> i32 status (0 ok), i32 n_cached
+//   RESET     -> i32 status
+
+#include "llama-memory.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+enum llama_remote_op : uint32_t {
+    LLAMA_REMOTE_INFO     = 1,
+    LLAMA_REMOTE_DECODE   = 2,
+    LLAMA_REMOTE_TRUNCATE = 3,
+    LLAMA_REMOTE_RESET    = 4,
+};
+
+struct llama_remote_client {
+    explicit llama_remote_client(const std::string & path);
+    ~llama_remote_client();
+
+    int32_t n_vocab  = 0;
+    int32_t n_ctx    = 0;
+    int32_t n_embd   = 0;
+    int32_t n_cached = 0;   // positions the engine holds for the (single) sequence
+
+    // logits receives one row of n_vocab floats per want[i] != 0, in batch order
+    int  decode(const std::vector<int32_t> & tokens, int32_t pos0,
+                const std::vector<uint8_t> & want, float * logits);
+    bool truncate(int32_t pos);
+    void reset();
+
+private:
+    int fd = -1;
+    void request(uint32_t op, uint32_t n, int32_t pos0, uint32_t n_out);
+    void send_all(const void * p, size_t n);
+    void recv_all(void * p, size_t n);
+};
+
+// Memory module for a remote backend: one sequence, appended in order. Truncation is
+// whatever the engine supports (its current end, 0, or a checkpoint it holds); when it
+// fails, callers clear and re-process, as they do for recurrent models.
+struct llama_memory_remote : public llama_memory_i {
+    explicit llama_memory_remote(llama_remote_client & client) : cl(client) {}
+
+    llama_memory_context_ptr init_batch(llama_batch_allocr &, uint32_t, bool) override { return nullptr; }
+    llama_memory_context_ptr init_full() override { return nullptr; }
+    llama_memory_context_ptr init_update(llama_context *, bool) override { return nullptr; }
+
+    bool get_can_shift() const override { return false; }
+
+    void clear(bool data) override;
+
+    bool seq_rm  (llama_seq_id seq_id, llama_pos p0, llama_pos p1) override;
+    void seq_cp  (llama_seq_id, llama_seq_id, llama_pos, llama_pos) override {}
+    void seq_keep(llama_seq_id) override {}
+    void seq_add (llama_seq_id, llama_pos, llama_pos, llama_pos) override {}
+    void seq_div (llama_seq_id, llama_pos, llama_pos, int) override {}
+
+    // reported like recurrent memory: only the latest state is held, so callers re-process
+    // from 0 rather than truncate into the middle
+    llama_pos seq_pos_min(llama_seq_id) const override { return cl.n_cached - 1; }
+    llama_pos seq_pos_max(llama_seq_id) const override { return cl.n_cached - 1; }
+
+    std::map<ggml_backend_buffer_type_t, size_t> memory_breakdown() const override { return {}; }
+
+    void state_write(llama_io_write_i &, llama_seq_id, llama_state_seq_flags) const override;
+    void state_read (llama_io_read_i  &, llama_seq_id, llama_state_seq_flags) override;
+
+    llama_remote_client & cl;
+};
