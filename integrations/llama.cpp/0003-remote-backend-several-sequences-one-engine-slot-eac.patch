+int llama_remote_client::decode_multi(const std::vector<llama_remote_seg> & segs, const std::vector<int32_t> & tokens,
+                                      const std::vector<uint8_t> & want, float * logits) {
+    uint32_t n_out = 0;
+    for (uint8_t w : want) {
+        n_out += w != 0;
+    }
