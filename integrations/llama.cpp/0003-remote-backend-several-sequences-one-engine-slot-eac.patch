+bool llama_remote_client::copy(int32_t src, int32_t dst) {
+    if (src < 0 || src >= n_slots || dst < 0 || dst >= n_slots) {
+        return false;
+    }
+    if (src == dst) {
+        return true;
+    }
+    request(LLAMA_REMOTE_COPY, (uint32_t) src, dst, 0);
