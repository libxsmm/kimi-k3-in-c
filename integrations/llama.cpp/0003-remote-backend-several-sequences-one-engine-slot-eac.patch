+    send_all(segs.data(), segs.size() * sizeof(llama_remote_seg));
+    send_all(tokens.data(), tokens.size() * sizeof(int32_t));
+    send_all(want.data(), want.size());
+    int32_t status = 0;
+    recv_all(&status, sizeof(status));
+    std::vector<int32_t> mp(segs.size());
+    recv_all(mp.data(), mp.size() * sizeof(int32_t));
+    // the engine leaves the last segment's slot selected
