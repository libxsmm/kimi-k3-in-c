+void llama_memory_remote::seq_cp(llama_seq_id seq_id_src, llama_seq_id seq_id_dst, llama_pos p0, llama_pos p1) {
+    if (seq_id_src == seq_id_dst || seq_id_src < 0 || seq_id_src >= cl.n_slots) {
+        return;
+    }
+    if (p0 > 0) {
+        LLAMA_LOG_WARN("%s: the remote backend copies whole sequences only\n", __func__);
+        return;
+    }
+    if (!cl.copy(seq_id_src, seq_id_dst)) {
+        LLAMA_LOG_WARN("%s: the engine could not copy sequence %d to %d\n", __func__, seq_id_src, seq_id_dst);
+        return;
+    }
+    if (p1 >= 0 && p1 < cl.n_cached[seq_id_dst] && !cl.truncate(seq_id_dst, p1)) {
