+void llama_memory_remote::seq_keep(llama_seq_id seq_id) {
+    for (int32_t s = 0; s < cl.n_slots; ++s) {
+        if (s != seq_id && cl.n_cached[s] > 0) {
+            cl.reset(s);
+        }
+    }
 }
 
