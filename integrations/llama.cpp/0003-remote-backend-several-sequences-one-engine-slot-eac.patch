+void llama_remote_client::open_slots() {
+    request(LLAMA_REMOTE_SLOT, 0, 0, 0);
+    int32_t r[4];
+    recv_all(r, sizeof(r));
+    if (r[0] != 0 || r[1] < 1) {
+        throw std::runtime_error("remote backend: the engine refused SLOT");
+    }
+    n_slots = r[1];
+    n_cached.assign(n_slots, 0);
+    min_pos.assign(n_slots, 0);
+    n_cached[0] = r[2];
+    min_pos[0]  = r[3];
+    cur = 0;
+    for (int32_t s = 1; s < n_slots; ++s) {
+        select(s);
+    }
+    select(0);
+}
+
+void llama_remote_client::select(int32_t slot) {
+    if (slot == cur) {
+        return;
+    }
+    if (slot < 0 || slot >= n_slots) {
+        throw std::runtime_error("remote backend: no engine slot " + std::to_string(slot));
+    }
+    request(LLAMA_REMOTE_SLOT, 0, slot, 0);
+    int32_t r[4];
+    recv_all(r, sizeof(r));
+    if (r[0] != 0) {
+        throw std::runtime_error("remote backend: the engine refused slot " + std::to_string(slot));
+    }
+    cur = slot;
+    n_cached[slot] = r[2];
+    min_pos[slot]  = r[3];
+}
+
